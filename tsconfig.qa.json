{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".qa-build",
    "rootDir": ".",
    "noEmit": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": [
    "scripts/check-curriculum-quality.ts",
    "scripts/check-objective-graph.ts",
    "scripts/check-independent-evidence.ts",
    "lib/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".qa-build"]
}